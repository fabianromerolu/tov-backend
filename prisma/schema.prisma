// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String   // nombre (primer nombre)
  lastName  String   // apellido
  email     String
  country   String   // país
  phone     String   // teléfono
  message   String   // motivo o mensaje
  createdAt DateTime @default(now())
}

model Encuesta {
  id                     Int      @id @default(autoincrement())
  emociones              Json
  otraEmocion            String?  @db.VarChar(80)
  nivelIdentificacion    Int
  impactoAutopercepcion  String   @db.VarChar(32)
  deseaMasIniciativas    String   @db.VarChar(16)
  comentario             String?  @db.VarChar(500)
  consentimiento         Boolean
  createdAt              DateTime @default(now())
}

// Buzón posterior al cierre: sus mensajes no forman parte de Encuesta ni de sus agregados.
model BuzonSugerencia {
  id         Int      @id @default(autoincrement())
  comentario String   @db.VarChar(500)
  createdAt  DateTime @default(now())
}
